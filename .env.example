# Скопировать не нужно: всё удобнее вставить в «Настройках» прототипа, он сам создаст .env
FAL_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DEMO_MODE=1
DAILY_LIMIT_USD=10
USD_RUB=84.41
# Claude по подписке (Claude Code). На Mac достаточно один раз войти командой claude.
CLAUDE_MODEL=opus
CLAUDE_BIN=
# На сервере: токен из `claude setup-token` (действует год)
CLAUDE_CODE_OAUTH_TOKEN=
# кто какую работу делает: claude | gemini
PROVIDER_SCENARIO=claude
PROVIDER_RESEARCH=claude
PROVIDER_MONTAGE=claude
PROVIDER_TASTE=claude
PROVIDER_PUBLISH=claude
PROVIDER_PASSPORT=gemini
CONCEPTS_N=3
AUTO_RETRY=1
VERTICAL_MODE=nb2
MONTAGE_FIT=crop
APIFY_TOKEN=
# своя папка библиотеки «По изделиям»; пусто = library/ в проекте
LIBRARY_DIR=
# сервер: наружу (0.0.0.0) откроется только с паролем
HOST=127.0.0.1
PORT=8765
AUTH_USER=admin
AUTH_PASSWORD=
